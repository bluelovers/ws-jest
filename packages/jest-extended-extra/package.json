{
  "name": "jest-extended-extra",
  "version": "1.0.21",
  "description": "Jest extended matchers collection for numeric types / Jest 擴展數字型別匹配器集合",
  "keywords": [
    "assert",
    "test",
    "check",
    "assertion",
    "testing",
    "chai",
    "expect",
    "jest",
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/ws-jest/tree/master/packages/jest-extended-extra#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-jest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-jest.git",
    "directory": "packages/jest-extended-extra"
  },
  "license": "ISC",
  "author": "bluelovers",
  "sideEffects": false,
  "main": "index.js",
  "types": "./index.d.ts",
  "typings": "./index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "pretest": "pnpm run build",
    "test": "node --run test:jest --",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "build": "tsx ./test/scripts/build-matchers.ts",
    "postbuild": "pnpm run postbuild:commit",
    "postbuild:commit": "git commit -m \"build(matchers): update index of matchers\" ./lib/matchers.ts ./lib/matchers.d.ts ./lib/matchers.js & echo postbuild:commit",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "publish": "echo publish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-assert/check-basic": "^1.0.13",
    "@lazy-assert/jest-util": "^1.0.6",
    "check-types": "^11.2.3",
    "jest-install-matcher-extends": "^1.0.16"
  }
}
